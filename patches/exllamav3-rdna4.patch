+typedef _Float16 exl3_h8 __attribute__((ext_vector_type(8)));
+typedef float exl3_f8 __attribute__((ext_vector_type(8)));
+
+static inline int exl3_gemv_wmma_m(int rows)
+{
+    return rows <= 8 ? 8 : (rows <= 16 ? 16 : 32);
+}
