+                   std::strncmp(props.gcnArchName, "gfx1201", 7) == 0) &&
+                  (props.gcnArchName[7] == '\0' || props.gcnArchName[7] == ':');
+        e = ok ? 1 : -1;
+        eligible[device].store(e, std::memory_order_relaxed);
+    }
+    return e > 0;
