+            else              LAUNCH_REPLAY(gdn_replay_state_kernel_128<1, true>)
+        }
+        else
+        {
+            if (v_split == 4) LAUNCH_REPLAY(gdn_replay_state_kernel_128<4, false>)
+            else              LAUNCH_REPLAY(gdn_replay_state_kernel_128<1, false>)
+        }
+        #undef LAUNCH_REPLAY
+        cuda_check(cudaPeekAtLastError());
