+        dim3 blocks(n, num_v_heads, v_split);
+        #define LAUNCH_REPLAY(...) \
+            __VA_ARGS__<<<blocks, threads, 0, stream>>>(state_batch, accepted, num_k_heads, num_v_heads);
+        if (channelwise)
