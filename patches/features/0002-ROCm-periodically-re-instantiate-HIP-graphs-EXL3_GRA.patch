From 9f91c4ccd153dcb5abe497f79d9293245c903b9d Mon Sep 17 00:00:00 2001
From: local <local@localhost>
Date: Tue, 6 Oct 2026 11:55:03 +0530
Subject: [PATCH 02/18] ROCm: periodically re-instantiate HIP graphs
 (EXL3_GRAPH_REINST)

hipGraphExecKernelNodeSetParams draws on a fixed per-exec kernel-argument
pool that is never reclaimed: after about 1.6M updates the next one segfaults
inside libamdhip64 (reproduced standalone on ROCm 7.2 / gfx1201; matches
ROCm/rocm-systems#10713). With graph-captured decode that is about an hour of
serving.

Graph::launch now counts node parameter updates and, once it reaches
EXL3_GRAPH_REINST (default 100000, 0 disables), synchronizes the stream,
re-instantiates graph_exec and marks every node with a patch site for update,
so the current node_params are applied again. ROCm builds only. Output is
byte-identical even when re-instantiating every 1,000 updates.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 doc/env_vars.md                   |  8 ++++++++
 exllamav3/exllamav3_ext/graph.cu  | 25 +++++++++++++++++++++++++
 exllamav3/exllamav3_ext/graph.cuh |  2 ++
 3 files changed, 35 insertions(+)

diff --git a/doc/env_vars.md b/doc/env_vars.md
index 47e8f7d..e203023 100644
--- a/doc/env_vars.md
+++ b/doc/env_vars.md
@@ -37,6 +37,14 @@ span-heads head norms, non-EXL3 projections, compander-enabled quant cache, ...)
 the regular dispatch path by design. Unexpected errors while building the path are raised, not
 swallowed. Set to `0` to disable the path entirely.
 
+### `EXL3_GRAPH_REINST` (ROCm; default: `100000`)
+
+HIP keeps a fixed pool of kernel-argument space per instantiated graph and does not reclaim it
+on `hipGraphExecKernelNodeSetParams`: after about 1.6M parameter updates (around an hour of
+serving with graph-captured decode) the next update segfaults inside libamdhip64. A graph is
+therefore re-instantiated once it has taken this many node parameter updates, and its patched
+nodes are set again from their current values. `0` disables. No effect on CUDA builds.
+
 ### `EXL3_BC_ATTN_TRACE` (default: `0`)
 
 Print one line per attention module/cache-layer pair when the graph-captured decode path is
diff --git a/exllamav3/exllamav3_ext/graph.cu b/exllamav3/exllamav3_ext/graph.cu
index c16fec7..fb26172 100644
--- a/exllamav3/exllamav3_ext/graph.cu
+++ b/exllamav3/exllamav3_ext/graph.cu
@@ -19,6 +19,7 @@ Graph::Graph()
     graph = NULL;
     graph_exec = NULL;
     need_cublas = false;
+    param_updates = 0;
 }
 
 Graph::~Graph()
@@ -170,9 +171,33 @@ void Graph::launch(std::vector<PPTR> params, cudaStream_t stream)
         if (n == graph_node_sites.size()) TORCH_CHECK(false, "Graph update failed");
     }
 
+    #ifdef USE_ROCM
+        // HIP's graph exec keeps a fixed pool of kernel-argument space and never reclaims it on
+        // hipGraphExecKernelNodeSetParams: after ~1.6M updates the next one segfaults inside libamdhip64
+        // (reproduced standalone on ROCm 7.2 / gfx1201; matches ROCm/rocm-systems#10713). Re-instantiating
+        // frees the pool, after which every node with a patch site is set again from node_params, which
+        // already hold the current values. EXL3_GRAPH_REINST overrides the interval (0 disables).
+        {
+            static const long reinst_every = []() {
+                const char* env = std::getenv("EXL3_GRAPH_REINST");
+                return env ? atol(env) : 100000L;
+            }();
+            if (reinst_every > 0 && param_updates >= reinst_every)
+            {
+                cuda_check(cudaStreamSynchronize(stream));
+                cuda_check(cudaGraphExecDestroy(graph_exec));
+                cuda_check(cudaGraphInstantiate(&graph_exec, graph, nullptr, nullptr, 0));
+                for (auto& site : graph_node_sites)
+                    if (std::get<1>(site) != GP_end) node_needs_update[std::get<0>(site)] = true;
+                param_updates = 0;
+            }
+        }
+    #endif
+
     for (int n = 0; n < nodes.size(); ++n)
     {
         if (!node_needs_update[n]) continue;
+        param_updates++;
         if (node_is_driver[n])
         {
             CUresult r = CudaDrv::instance().graph_exec_kernel_node_set_params((CUgraphExec) graph_exec, (CUgraphNode) nodes[n], &node_params_drv[n]);
diff --git a/exllamav3/exllamav3_ext/graph.cuh b/exllamav3/exllamav3_ext/graph.cuh
index 45f33c9..6e3f03d 100644
--- a/exllamav3/exllamav3_ext/graph.cuh
+++ b/exllamav3/exllamav3_ext/graph.cuh
@@ -119,6 +119,8 @@ public:
     std::vector<char> node_is_driver;
     std::vector<void*> current_values;
     std::vector<bool> node_needs_update;
+    // ROCm: node parameter updates since graph_exec was (re)instantiated, see Graph::launch
+    long param_updates;
 
     bool need_cublas;
     bool ready;
