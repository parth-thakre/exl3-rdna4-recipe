+def _env_pow2(name: str) -> int | None:
+    """A power-of-two launch override from the environment, None when unset"""
+    if not (v := os.environ.get(name)):
+        return None
+    n = int(v)
+    if n <= 0 or n & (n - 1):
+        raise ValueError(f"{name}={v}: must be a positive power of two")
+    return n
+
