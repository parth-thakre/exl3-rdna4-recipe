diff --git a/exllamav3/architecture/dflash2.py b/exllamav3/architecture/dflash2.py
index ff85e97..b01d777 100644
--- a/exllamav3/architecture/dflash2.py
+++ b/exllamav3/architecture/dflash2.py
@@ -273,8 +273,19 @@ class DFlash2Model(Model):
         target verifier still samples normally and accepts only exact matches."""
         target = self.attached_model()
         lm = target.modules[target.logit_layer_idx]
-        logits = lm.prepare_for_device(state.half(), params)
-        logits = lm.forward(logits, params)
+        # The generator's row budget may use only the first `rows` path positions. The walk is
+        # sequential (row i depends on rows < i only) and the head is row-wise, so the head and the
+        # walk run over block rows 1..rows alone: the anchor row's logits are never used, and rows
+        # past the window would only cost head rows (the target's head, the widest linear)
+        rows = params.get("dflash2_rows")
+        if rows is not None and 0 < rows < state.shape[1] - 1:
+            path_state = state[:, 1:1 + rows]
+            logits = lm.prepare_for_device(path_state.half().contiguous(), params)
+            logits = lm.forward(logits, params)
+        else:
+            path_state = state[:, 1:]
+            logits = lm.prepare_for_device(state.half(), params)
+            logits = lm.forward(logits, params)[:, 1:]
 
         dev = self.selector.device
         # The generator stages the block ids in pinned memory: upload without a host sync
@@ -286,7 +297,7 @@ class DFlash2Model(Model):
         # (draft's last block) and the logits (target's head) may sit on other devices than
         # the selector: to_device bounces pairs with a broken peer path through the host
         out, confidence = self.selector.walk_block(
-            to_device(state[:, 1:], dev), to_device(logits[:, 1:], dev), anchor,
+            to_device(path_state, dev), to_device(logits, dev), anchor,
             return_confidence = export_conf,
             vocab_size = target.config.vocab_size,
             scale = self.config.output_multiplier,
