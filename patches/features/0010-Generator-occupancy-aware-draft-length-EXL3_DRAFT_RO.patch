+    def _budget_draft_window(self, window: int) -> int:
+        """
+        Draft length for this round under EXL3_DRAFT_ROW_BUDGET (see __init__): the verify forward
+        takes (window + 1) rows per active sequence. Never below 1, so draft-model caches that are
+        only advanced by drafting (AR draft models, MTP) keep advancing; unchanged when the budget
+        is off.
+        """
+        if self.draft_row_budget <= 0 or window <= 1:
+            return window
+        rows = sum(len(job.sequences) for job in self.active_jobs if job.is_prefill_done())
+        if rows == 0:
+            return window
+        return max(1, min(window, self.draft_row_budget // rows - 1))
+
+
     def _staging(self, name, rows: int, width: int | None = None, dtype = torch.int32):
         """
         Reusable pinned staging buffer, keyed by name and row width, grown by rows on demand.
